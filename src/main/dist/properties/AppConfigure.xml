<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "http://www.springframework.org/dtd/spring-beans.dtd">
<beans>
    <bean id="loader" class="edu.mcw.rgd.data.EnsemblLoader">
        <property name="version" value="ensembl-data-pipeline  -- build Sep 11, 2026"/>
        <property name="dataPuller" ref="ensemblDataPuller"/>
        <property name="dataParser" ref="Parser"/>
        <property name="dataGff3Parser" ref="gff3Parser"/>
        <property name="geneLoader" ref="GeneLoader"/>
        <property name="transcriptLoader" ref="TranscriptLoader"/>
        <!-- every assembly processed by the pipeline: one bean per assembly, grouped per species.
             Per assembly: the map keys the data is loaded onto (ensemblMapKey = the map the Ensembl positions
             go to; ncbiMapKey = the NCBI map used for gene-by-position matching, 0/absent = none;
             a strain assembly has ONE shared map key: Ensembl and NCBI positions coexist on it,
             distinguished by SRC_PIPELINE), the xref authority in the gff3 gene description,
             and the gff3/entrez source files (update file names on each Ensembl release). -->
        <property name="assemblies">
            <list>
                <!-- ================= rat (species 3) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- GRCr8, the primary rat assembly -->
                    <property name="speciesTypeKey" value="3"/>
                    <property name="ensemblMapKey" value="381"/><!-- 'GRCr8 Ensembl' -->
                    <property name="ncbiMapKey" value="380"/><!-- 'GRCr8' -->
                    <property name="xrefAuthority" value="RGD"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/rattus_norvegicus/Rattus_norvegicus.GRCr8.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/rattus_norvegicus/Rattus_norvegicus.GRCr8.116.entrez.tsv.gz"/>
                </bean>
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- SHR/Utx strain assembly UTH_Rnor_SHR_Utx -->
                    <property name="speciesTypeKey" value="3"/>
                    <property name="ensemblMapKey" value="301"/>
                    <property name="ncbiMapKey" value="301"/><!-- shared map key -->
                    <property name="xrefAuthority" value="RGD"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/rattus_norvegicus_shrutx/Rattus_norvegicus_shrutx.UTH_Rnor_SHR_Utx.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/rattus_norvegicus_shrutx/Rattus_norvegicus_shrutx.UTH_Rnor_SHR_Utx.116.entrez.tsv.gz"/>
                </bean>
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- SHRSP/BbbUtx strain assembly UTH_Rnor_SHRSP_BbbUtx_1.0 -->
                    <property name="speciesTypeKey" value="3"/>
                    <property name="ensemblMapKey" value="302"/>
                    <property name="ncbiMapKey" value="302"/><!-- shared map key -->
                    <property name="xrefAuthority" value="RGD"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/rattus_norvegicus_shrspbbbutx/Rattus_norvegicus_shrspbbbutx.UTH_Rnor_SHRSP_BbbUtx_1.0.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/rattus_norvegicus_shrspbbbutx/Rattus_norvegicus_shrspbbbutx.UTH_Rnor_SHRSP_BbbUtx_1.0.116.entrez.tsv.gz"/>
                </bean>
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- WKY/Bbb strain assembly UTH_Rnor_WKY_Bbb_1.0 -->
                    <property name="speciesTypeKey" value="3"/>
                    <property name="ensemblMapKey" value="303"/>
                    <property name="ncbiMapKey" value="303"/><!-- shared map key -->
                    <property name="xrefAuthority" value="RGD"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/rattus_norvegicus_wkybbb/Rattus_norvegicus_wkybbb.UTH_Rnor_WKY_Bbb_1.0.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/rattus_norvegicus_wkybbb/Rattus_norvegicus_wkybbb.UTH_Rnor_WKY_Bbb_1.0.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= mouse (species 2) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- GRCm39 -->
                    <property name="speciesTypeKey" value="2"/>
                    <property name="ensemblMapKey" value="240"/><!-- 'GRCm39 Ensembl' -->
                    <property name="ncbiMapKey" value="239"/><!-- 'GRCm39' -->
                    <property name="xrefAuthority" value="MGI"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/mus_musculus/Mus_musculus.GRCm39.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/mus_musculus/Mus_musculus.GRCm39.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= human (species 1) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- GRCh38 -->
                    <property name="speciesTypeKey" value="1"/>
                    <property name="ensemblMapKey" value="40"/><!-- 'GRCh38.p14 Ensembl' -->
                    <property name="ncbiMapKey" value="38"/><!-- 'GRCh38' -->
                    <property name="xrefAuthority" value="HGNC"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/homo_sapiens/Homo_sapiens.GRCh38.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/homo_sapiens/Homo_sapiens.GRCh38.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= chinchilla (species 4) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- ChiLan1.0 -->
                    <property name="speciesTypeKey" value="4"/>
                    <property name="ensemblMapKey" value="45"/>
                    <property name="ncbiMapKey" value="44"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/chinchilla_lanigera/Chinchilla_lanigera.ChiLan1.0.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/chinchilla_lanigera/Chinchilla_lanigera.ChiLan1.0.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= bonobo (species 5) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- PanPan1.1 -->
                    <property name="speciesTypeKey" value="5"/>
                    <property name="ensemblMapKey" value="512"/>
                    <property name="ncbiMapKey" value="511"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/pan_paniscus/Pan_paniscus.panpan1.1.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/pan_paniscus/Pan_paniscus.panpan1.1.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= dog (species 6) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- ROS_Cfam_1.0 -->
                    <property name="speciesTypeKey" value="6"/>
                    <property name="ensemblMapKey" value="638"/>
                    <property name="ncbiMapKey" value="634"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/canis_lupus_familiaris/Canis_lupus_familiaris.ROS_Cfam_1.0.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/canis_lupus_familiaris/Canis_lupus_familiaris.ROS_Cfam_1.0.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= squirrel (species 7) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- SpeTri2.0 -->
                    <property name="speciesTypeKey" value="7"/>
                    <property name="ensemblMapKey" value="721"/>
                    <property name="ncbiMapKey" value="720"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/ictidomys_tridecemlineatus/Ictidomys_tridecemlineatus.SpeTri2.0.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/ictidomys_tridecemlineatus/Ictidomys_tridecemlineatus.SpeTri2.0.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= pig (species 9) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- Sscrofa11.1 -->
                    <property name="speciesTypeKey" value="9"/>
                    <property name="ensemblMapKey" value="912"/>
                    <property name="ncbiMapKey" value="911"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/sus_scrofa/Sus_scrofa.Sscrofa11.1.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/sus_scrofa/Sus_scrofa.Sscrofa11.1.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= vervet (species 13) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- ChlSab1.1 -->
                    <property name="speciesTypeKey" value="13"/>
                    <property name="ensemblMapKey" value="1312"/>
                    <property name="ncbiMapKey" value="1311"/>
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/chlorocebus_sabaeus/Chlorocebus_sabaeus.ChlSab1.1.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/chlorocebus_sabaeus/Chlorocebus_sabaeus.ChlSab1.1.116.entrez.tsv.gz"/>
                </bean>

                <!-- ================= naked mole-rat (species 14) ================= -->
                <bean class="edu.mcw.rgd.data.AssemblyConfig"><!-- 'Naked mole-rat maternal' (GCA_944319715.1); no NCBI/RefSeq counterpart -->
                    <property name="speciesTypeKey" value="14"/>
                    <property name="ensemblMapKey" value="1412"/>
                    <!-- no ncbiMapKey: Ensembl-only assembly -->
                    <property name="assemblyName" value="Naked_mole-rat_maternal Ensembl"/><!-- map_name has spaces; use Ensembl's underscore form for the transcript file name + BioMart name check -->
                    <property name="gff3Url" value="https://ftp.ensembl.org/pub/current/gff3/heterocephalus_glaber_female/Heterocephalus_glaber_female.Naked_mole-rat_maternal.116.gff3.gz"/>
                    <property name="entrezUrl" value="https://ftp.ensembl.org/pub/current/tsv/heterocephalus_glaber_female/Heterocephalus_glaber_female.Naked_mole-rat_maternal.116.entrez.tsv.gz"/>
                </bean>
            </list>
        </property>
    </bean>

    <bean id="ensemblDataPuller" class="edu.mcw.rgd.data.EnsemblDataPuller">
        <property name="websiteUrl" value="http://www.ensembl.org/biomart/martservice"/>
        <property name="restGenomeUrl" value="http://rest.ensembl.org/info/genomes/"/><!-- append species, f.e. http://rest.ensembl.org/info/genomes/Sus_scrofa -->
        <property name="biomartQueryTemplate" value="properties/biomart.xml"/>
        <property name="biomartRetryCount" value="3"/><!-- number of retries after an initial BioMart failure; total attempts = retries + 1 -->
        <property name="biomartRetryDelaySeconds" value="60"/>
        <property name="biomartQueryAttrsGenes"><!-- ensembl gene attributes common to all species -->
            <list>
                <value>chromosome_name</value>
                <value>start_position</value>
                <value>end_position</value>
                <value>strand</value>
                <value>entrezgene_id</value>
                <value>external_gene_name</value>
                <value>gene_biotype</value>
                <value>description</value>
            </list>
        </property>
        <property name="biomartQueryAttrsTranscripts"><!-- ensembl transcript attributes common to all species -->
            <list>
                <value>ensembl_transcript_id</value>
                <value>ensembl_transcript_id_version</value>
                <value>chromosome_name</value>
                <value>transcript_start</value>
                <value>transcript_end</value>
                <value>strand</value>
                <value>exon_chrom_start</value>
                <value>exon_chrom_end</value>
                <value>rank</value>
                <value>genomic_coding_start</value>
                <value>genomic_coding_end</value>
                <value>ensembl_peptide_id</value>
                <value>transcript_biotype</value>
            </list>
        </property>
        <property name="biomartQueryAttrsRatGenes"><!-- ensembl gene attributes specific to rat -->
            <list>
                <value>rgd_id</value>
            </list>
        </property>
        <property name="biomartQueryAttrsMouseGenes"><!-- ensembl gene attributes specific to rat -->
            <list>
                <value>mgi_id</value>
            </list>
        </property>
        <property name="biomartQueryAttrsHumanGenes"><!-- ensembl gene attributes specific to rat -->
            <list>
                <value>hgnc_id</value>
            </list>
        </property>

    </bean>

    <bean id="GeneLoader" class="edu.mcw.rgd.data.EnsemblGeneLoader">
    </bean>

    <bean id="TranscriptLoader" class="edu.mcw.rgd.data.EnsemblTranscriptLoader">
    </bean>

    <bean id="Parser" class="edu.mcw.rgd.data.Parser">
    </bean>

    <!-- main-release GFF3 parser; per-species values are set by EnsemblLoader at runtime (next increment).
         Template (rat, Ensembl 115):
         genomeBuild         = GRCr8
         ensemblGenePrefix   = ENSRNOG
         xrefAuthority       = RGD          (RGD | MGI | HGNC | empty)
         ensemblAssemblyMapKey = 381        ncbiAssemblyMapKey = 380
         gff3File            = data/<species>.gff3.gz   (current_gff3/<species>/<Species>.<assembly>.<rel>.gff3.gz)
         entrezFile          = data/<species>.entrez.tsv.gz   (current_tsv/<species>/<Species>.<assembly>.<rel>.entrez.tsv.gz) -->
    <bean id="gff3Parser" class="edu.mcw.rgd.data.EnsemblGff3Parser"/>
</beans>