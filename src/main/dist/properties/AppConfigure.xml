<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "http://www.springframework.org/dtd/spring-beans.dtd">
<beans>
    <bean id="loader" class="edu.mcw.rgd.data.EnsemblLoader">
        <property name="version" value="ensembl-data-pipeline  -- build Jun 8, 2026"/>
        <property name="dataPuller" ref="ensemblDataPuller"/>
        <property name="dataParser" ref="Parser"/>
        <property name="dataGff3Parser" ref="gff3Parser"/>
        <property name="geneLoader" ref="GeneLoader"/>
        <property name="transcriptLoader" ref="TranscriptLoader"/>
        <property name="ensemblAssemblyMap">
            <map>
                <entry key="3" value="381"/><!-- rat GRCr8 -->
                <entry key="2" value="240"/><!-- mouse GRCm39 -->
                <entry key="1" value="40"/><!-- human GRCh38.p14 -->
                <entry key="4" value="45"/><!-- chinchilla ChiLan1.0 -->
                <entry key="6" value="638"/><!-- dog ROS_Cfam_1.0 -->
                <entry key="9" value="912" /><!-- pig Sscrofa11.1 -->
                <entry key="5" value="512"/><!-- bonobo PanPan1.1 -->
                <entry key="13" value="1312" /><!-- vervet ChlSab1.1 -->
                <entry key="14" value="1412" /><!-- naked mole-rat 'Naked mole-rat maternal' -->
                <entry key="7" value="721"/><!-- squirrel SpeTri2.0 -->
            </map>
        </property>
        <property name="ncbiAssemblyMap">
            <map>
                <entry key="3" value="380"/><!-- rat GRCr8 -->
                <entry key="2" value="239"/><!-- mouse GRCm39 -->
                <entry key="1" value="38"/><!-- human GRCh38 -->
                <entry key="4" value="44"/><!-- chinchilla ChiLan1.0 -->
                <entry key="6" value="634"/><!-- dog ROS_Cfam_1.0 -->
                <entry key="9" value="911" /><!-- pig Sscrofa11.1 -->
                <entry key="5" value="511"/><!-- bonobo PanPan1.1 -->
                <entry key="13" value="1311" /><!-- vervet ChlSab1.1 -->
                <!-- naked mole-rat (14): no NCBI map; the Ensembl 'Naked mole-rat maternal' (GCA_944319715.1) has no NCBI/RefSeq counterpart -->
                <entry key="7" value="720" /><!-- squirrel SpeTri2.0 -->
            </map>
        </property>
        <property name="assemblyMapNames" ><!-- assembly map names, as found at Ensembl or  NCBI -->
            <map>
                <entry key="1412" value="Naked_mole-rat_maternal Ensembl" /><!-- map_name has spaces; use Ensembl's underscore form for the transcript file name + BioMart name check -->
            </map>
        </property>
        <property name="gff3XrefAuthorities"><!-- gff3 loader: species type key -> species xref authority in the gff3 gene description -->
            <map>
                <entry key="3" value="RGD"/><!-- rat -->
                <entry key="2" value="MGI"/><!-- mouse -->
                <entry key="1" value="HGNC"/><!-- human -->
            </map>
        </property>
        <property name="gff3SourceFiles"><!-- gff3 loader: species type key -> full Ensembl GFF3 source URL (update file names on each Ensembl release) -->
            <map>
                <entry key="3"  value="https://ftp.ensembl.org/pub/current_gff3/rattus_norvegicus/Rattus_norvegicus.GRCr8.115.gff3.gz"/><!-- rat -->
                <entry key="2"  value="https://ftp.ensembl.org/pub/current_gff3/mus_musculus/Mus_musculus.GRCm39.115.gff3.gz"/><!-- mouse -->
                <entry key="1"  value="https://ftp.ensembl.org/pub/current_gff3/homo_sapiens/Homo_sapiens.GRCh38.115.gff3.gz"/><!-- human -->
                <entry key="4"  value="https://ftp.ensembl.org/pub/current_gff3/chinchilla_lanigera/Chinchilla_lanigera.ChiLan1.0.115.gff3.gz"/><!-- chinchilla -->
                <entry key="6"  value="https://ftp.ensembl.org/pub/current_gff3/canis_lupus_familiaris/Canis_lupus_familiaris.ROS_Cfam_1.0.115.gff3.gz"/><!-- dog -->
                <entry key="9"  value="https://ftp.ensembl.org/pub/current_gff3/sus_scrofa/Sus_scrofa.Sscrofa11.1.115.gff3.gz"/><!-- pig -->
                <entry key="5"  value="https://ftp.ensembl.org/pub/current_gff3/pan_paniscus/Pan_paniscus.panpan1.1.115.gff3.gz"/><!-- bonobo -->
                <entry key="13" value="https://ftp.ensembl.org/pub/current_gff3/chlorocebus_sabaeus/Chlorocebus_sabaeus.ChlSab1.1.115.gff3.gz"/><!-- vervet -->
                <entry key="14" value="https://ftp.ensembl.org/pub/current_gff3/heterocephalus_glaber_female/Heterocephalus_glaber_female.Naked_mole-rat_maternal.115.gff3.gz"/><!-- naked mole-rat -->
                <entry key="7"  value="https://ftp.ensembl.org/pub/current_gff3/ictidomys_tridecemlineatus/Ictidomys_tridecemlineatus.SpeTri2.0.115.gff3.gz"/><!-- squirrel -->
            </map>
        </property>
        <property name="entrezSourceFiles"><!-- gff3 loader: species type key -> full Ensembl entrez (NCBI gene id) tsv source URL -->
            <map>
                <entry key="3"  value="https://ftp.ensembl.org/pub/current_tsv/rattus_norvegicus/Rattus_norvegicus.GRCr8.115.entrez.tsv.gz"/><!-- rat -->
                <entry key="2"  value="https://ftp.ensembl.org/pub/current_tsv/mus_musculus/Mus_musculus.GRCm39.115.entrez.tsv.gz"/><!-- mouse -->
                <entry key="1"  value="https://ftp.ensembl.org/pub/current_tsv/homo_sapiens/Homo_sapiens.GRCh38.115.entrez.tsv.gz"/><!-- human -->
                <entry key="4"  value="https://ftp.ensembl.org/pub/current_tsv/chinchilla_lanigera/Chinchilla_lanigera.ChiLan1.0.115.entrez.tsv.gz"/><!-- chinchilla -->
                <entry key="6"  value="https://ftp.ensembl.org/pub/current_tsv/canis_lupus_familiaris/Canis_lupus_familiaris.ROS_Cfam_1.0.115.entrez.tsv.gz"/><!-- dog -->
                <entry key="9"  value="https://ftp.ensembl.org/pub/current_tsv/sus_scrofa/Sus_scrofa.Sscrofa11.1.115.entrez.tsv.gz"/><!-- pig -->
                <entry key="5"  value="https://ftp.ensembl.org/pub/current_tsv/pan_paniscus/Pan_paniscus.panpan1.1.115.entrez.tsv.gz"/><!-- bonobo -->
                <entry key="13" value="https://ftp.ensembl.org/pub/current_tsv/chlorocebus_sabaeus/Chlorocebus_sabaeus.ChlSab1.1.115.entrez.tsv.gz"/><!-- vervet -->
                <entry key="14" value="https://ftp.ensembl.org/pub/current_tsv/heterocephalus_glaber_female/Heterocephalus_glaber_female.Naked_mole-rat_maternal.115.entrez.tsv.gz"/><!-- naked mole-rat -->
                <entry key="7"  value="https://ftp.ensembl.org/pub/current_tsv/ictidomys_tridecemlineatus/Ictidomys_tridecemlineatus.SpeTri2.0.115.entrez.tsv.gz"/><!-- squirrel -->
            </map>
        </property>
    </bean>

    <bean id="ensemblDataPuller" class="edu.mcw.rgd.data.EnsemblDataPuller">
        <property name="websiteUrl" value="http://www.ensembl.org/biomart/martservice"/>
        <property name="restGenomeUrl" value="http://rest.ensembl.org/info/genomes/"/><!-- append species, f.e. http://rest.ensembl.org/info/genomes/Sus_scrofa -->
        <property name="biomartQueryTemplate" value="properties/biomart.xml"/>
        <property name="biomartRetryCount" value="3"/><!-- number of retries after an initial BioMart failure; total attempts = retries + 1 -->
        <property name="biomartRetryDelaySeconds" value="60"/>
        <property name="biomartQueryAttrsGenes"><!-- ensembl gene attributes common to all species -->
            <list>
                <value>chromosome_name</value>
                <value>start_position</value>
                <value>end_position</value>
                <value>strand</value>
                <value>entrezgene_id</value>
                <value>external_gene_name</value>
                <value>gene_biotype</value>
                <value>description</value>
            </list>
        </property>
        <property name="biomartQueryAttrsTranscripts"><!-- ensembl transcript attributes common to all species -->
            <list>
                <value>ensembl_transcript_id</value>
                <value>ensembl_transcript_id_version</value>
                <value>chromosome_name</value>
                <value>transcript_start</value>
                <value>transcript_end</value>
                <value>strand</value>
                <value>exon_chrom_start</value>
                <value>exon_chrom_end</value>
                <value>rank</value>
                <value>genomic_coding_start</value>
                <value>genomic_coding_end</value>
                <value>ensembl_peptide_id</value>
                <value>transcript_biotype</value>
            </list>
        </property>
        <property name="biomartQueryAttrsRatGenes"><!-- ensembl gene attributes specific to rat -->
            <list>
                <value>rgd_id</value>
            </list>
        </property>
        <property name="biomartQueryAttrsMouseGenes"><!-- ensembl gene attributes specific to rat -->
            <list>
                <value>mgi_id</value>
            </list>
        </property>
        <property name="biomartQueryAttrsHumanGenes"><!-- ensembl gene attributes specific to rat -->
            <list>
                <value>hgnc_id</value>
            </list>
        </property>

    </bean>

    <bean id="GeneLoader" class="edu.mcw.rgd.data.EnsemblGeneLoader">
    </bean>

    <bean id="TranscriptLoader" class="edu.mcw.rgd.data.EnsemblTranscriptLoader">
    </bean>

    <bean id="Parser" class="edu.mcw.rgd.data.Parser">
    </bean>

    <!-- main-release GFF3 parser; per-species values are set by EnsemblLoader at runtime (next increment).
         Template (rat, Ensembl 115):
         genomeBuild         = GRCr8
         ensemblGenePrefix   = ENSRNOG
         xrefAuthority       = RGD          (RGD | MGI | HGNC | empty)
         ensemblAssemblyMapKey = 381        ncbiAssemblyMapKey = 380
         gff3File            = data/<species>.gff3.gz   (current_gff3/<species>/<Species>.<assembly>.<rel>.gff3.gz)
         entrezFile          = data/<species>.entrez.tsv.gz   (current_tsv/<species>/<Species>.<assembly>.<rel>.entrez.tsv.gz) -->
    <bean id="gff3Parser" class="edu.mcw.rgd.data.EnsemblGff3Parser"/>
</beans>